{
  "name": "@ban-sky/dsh-github",
  "version": "0.4.0",
  "description": "GitHub integration for DSH: official device-flow sign-in, repository creation, cloning, pull, commit and push. Security first.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ban-sky/dsh-github.git"
  },
  "homepage": "https://github.com/ban-sky/dsh-github#readme",
  "bugs": {
    "url": "https://github.com/ban-sky/dsh-github/issues"
  },
  "author": "ban-sky",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "GitHub",
      "en": "GitHub"
    },
    "icon": "fork",
    "wants": [
      "draft"
    ],
    "contributes": {
      "composer.actions": [
        {
          "id": "save-client-id",
          "label": {
            "zh": "存 ID",
            "en": "Save ID"
          },
          "icon": "save"
        },
        {
          "id": "commit-draft",
          "label": {
            "zh": "提交",
            "en": "Commit"
          },
          "icon": "check"
        }
      ],
      "composer.tools": [
        {
          "id": "github-open",
          "label": {
            "zh": "GitHub",
            "en": "GitHub"
          },
          "icon": "fork",
          "panel": "github"
        },
        {
          "id": "clone-repo",
          "label": {
            "zh": "克隆",
            "en": "Clone"
          },
          "icon": "download"
        }
      ],
      "panels": [
        {
          "id": "github",
          "title": {
            "zh": "GitHub",
            "en": "GitHub"
          },
          "icon": "fork",
          "placement": [
            "chat.panel",
            "session.tab",
            "features"
          ]
        }
      ]
    },
    "minApp": "1.0.13"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-go",
    "github",
    "git",
    "oauth"
  ]
}
